# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL / Prisma)
# In Docker Compose: postgresql://newtonite:password@postgres:5432/newtonite?schema=public
# In Local standalone / Preview: defaults gracefully to embedded Postgres engine (PGlite) if unreachable
DATABASE_URL="postgresql://newtonite:password@localhost:5432/newtonite?schema=public"

# Redis Configuration (BullMQ / Caching)
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET="newtonite-operations-under-pressure-secure-jwt-key"

# Outbox Worker Configuration
OUTBOX_POLL_INTERVAL_MS=2000
